generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  phone        String?
  createdAt    DateTime @default(now())

  /// E-posta adresinin doğrulandığı an. Null ise henüz doğrulanmamıştır.
  emailVerifiedAt DateTime?

  /// Oturum sürümü. Her oturum tokenı üretildiği andaki değeri taşır ve
  /// doğrulamada veritabanındaki güncel değerle TAM EŞİTLİK karşılaştırılır.
  ///
  /// Şifre değişimi, şifre sıfırlama veya "tüm oturumları kapat" işleminde
  /// artırılır; eski tokenlar anında geçersiz olur.
  ///
  /// Zaman damgası yerine sayaç kullanılmasının nedeni: JWT `iat` alanı
  /// saniye çözünürlüğündedir, bu yüzden zamana dayalı karşılaştırma ya
  /// kullanıcıyı kendi işleminde oturumdan atar ya da bir saniyelik açık
  /// bırakır. Sayaç karşılaştırması zamanlamadan tamamen bağımsızdır.
  sessionVersion Int @default(0)

  records                 ItemRecord[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  tags                    Tag[]

  /// Bu kullanıcının başlattığı ve kendisine gönderilen sahiplik devirleri.
  sentTransfers     OwnershipTransfer[] @relation("TransferFromUser")
  receivedTransfers OwnershipTransfer[] @relation("TransferToUser")
}

/// Şifre sıfırlama tokenları.
/// Token düz metin saklanmaz; yalnızca SHA-256 özeti tutulur.
/// Veritabanı sızsa bile özetten geçerli token üretilemez.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// E-posta doğrulama tokenları.
/// `email` alanı, ileride e-posta değişikliği doğrulaması için hedef adresi tutar.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ItemRecord {
  id          String   @id
  assetName   String
  ownerName   String
  phone       String
  email       String
  description String
  category    String
  status      String
  createdAt   DateTime

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  finderMessages FinderMessage[]

  /// Bu ürüne bağlı etiket. Eski (legacy) kayıtlarda etiket bulunmaz;
  /// onlar /item/<kayıt-id> adresinden erişilmeye devam eder.
  tag Tag?

  ownershipTransfers OwnershipTransfer[]
}

/// Fiziksel QR/NFC etiketi.
///
/// Eski akıştan farkı: genel erişim adresi veritabanı ID'si yerine
/// kriptografik olarak üretilmiş `publicToken` kullanır (/t/<token>).
/// Etiket, aktivasyon koduna sahip olan kullanıcı tarafından bir kez
/// aktive edilir ve bir ürüne bağlanır.
model Tag {
  id String @id @default(cuid())

  /// Etiketin üzerine basılan, insan tarafından okunabilen kod (ARK-XXXX-XXXX).
  /// Gizli değildir; yalnızca etiketi tanımlar.
  code String @unique

  /// QR/NFC adresinde kullanılan kriptografik token (256 bit).
  /// Tahmin edilemez ve veritabanı ID'si içermez.
  publicToken String @unique

  /// unused | active | inactive | revoked
  status String @default("unused")

  /// Aktivasyon kodunun SHA-256 özeti. Kod düz metin saklanmaz;
  /// yalnızca fiziksel etiketin üzerinde bulunur.
  activationCodeHash String

  activatedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Etiketi aktive eden (sahibi olan) kullanıcı.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Etiketin bağlı olduğu ürün. Bir ürünün en fazla bir etiketi olur.
  itemRecordId String?     @unique
  itemRecord   ItemRecord? @relation(fields: [itemRecordId], references: [id], onDelete: SetNull)

  events TagEvent[]

  @@index([status])
  @@index([userId])
}

/// Etiket geçmişi. Aktivasyon, ürün değişimi, devir ve iptal işlemleri
/// geri dönük olarak izlenebilsin diye kaydedilir.
model TagEvent {
  id String @id @default(cuid())

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  /// activated | moved | deactivated | reactivated | revoked | transferred
  type String

  /// İşlemi yapan kullanıcı. Yönetici işlemlerinde null olabilir.
  actorUserId String?

  fromItemRecordId String?
  toItemRecordId   String?
  fromUserId       String?
  toUserId         String?

  createdAt DateTime @default(now())

  @@index([tagId])
  @@index([createdAt])
}

enum OwnershipTransferStatus {
  pending
  accepted
  cancelled
  expired
}

/// Ürün sahipliğinin başka bir kullanıcıya devri.
///
/// Akış: mevcut sahip bir davet oluşturur, davet e-posta ile karşı tarafa
/// gider ve yalnızca karşı taraf kabul ederse ürün el değiştirir.
///
/// Token düz metin saklanmaz; PasswordResetToken'da olduğu gibi yalnızca
/// SHA-256 özeti tutulur. Davet tek kullanımlıktır, `expiresAt` ile sürelidir
/// ve kabul edilmeden önce gönderen tarafından iptal edilebilir.
model OwnershipTransfer {
  id String @id @default(cuid())

  itemRecordId String
  itemRecord   ItemRecord @relation(fields: [itemRecordId], references: [id], onDelete: Cascade)

  /// Daveti başlatan mevcut sahip.
  fromUserId String
  fromUser   User   @relation("TransferFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)

  /// Davet edilen kullanıcı. Davet anında hesabı yoksa null kalır ve
  /// kabul sırasında doldurulur.
  toUserId String?
  toUser   User?   @relation("TransferToUser", fields: [toUserId], references: [id], onDelete: SetNull)

  /// Davetin gönderildiği e-posta adresi.
  toEmail String

  tokenHash String @unique

  status OwnershipTransferStatus @default(pending)

  expiresAt   DateTime
  acceptedAt  DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemRecordId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([toEmail])
  @@index([status])
  @@index([expiresAt])
}

model FinderMessage {
  id                  String    @id
  recordId            String
  finderName          String
  finderPhone         String
  finderEmail         String?
  location            String
  message             String
  status              String
  emailDeliveryStatus String?
  emailDeliveredAt    DateTime?
  createdAt           DateTime

  record ItemRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

/// Hız sınırlama sayaçları.
///
/// Vercel birden fazla sunucu örneği çalıştırdığı için bellek içi sayaç
/// güvenilir değildir; sayaçlar tüm örneklerin paylaştığı veritabanında tutulur.
///
/// `key` alanı ham IP veya e-posta İÇERMEZ; kişisel veri saklamamak için
/// değerin HMAC-SHA256 özeti kullanılır.
model RateLimitEntry {
  key          String    @id
  count        Int       @default(0)
  windowEnd    DateTime
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([windowEnd])
}