generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  phone        String?
  createdAt    DateTime @default(now())

  /// E-posta adresinin doğrulandığı an. Null ise henüz doğrulanmamıştır.
  emailVerifiedAt DateTime?

  /// Oturum sürümü. Her oturum tokenı üretildiği andaki değeri taşır ve
  /// doğrulamada veritabanındaki güncel değerle TAM EŞİTLİK karşılaştırılır.
  ///
  /// Şifre değişimi, şifre sıfırlama veya "tüm oturumları kapat" işleminde
  /// artırılır; eski tokenlar anında geçersiz olur.
  ///
  /// Zaman damgası yerine sayaç kullanılmasının nedeni: JWT `iat` alanı
  /// saniye çözünürlüğündedir, bu yüzden zamana dayalı karşılaştırma ya
  /// kullanıcıyı kendi işleminde oturumdan atar ya da bir saniyelik açık
  /// bırakır. Sayaç karşılaştırması zamanlamadan tamamen bağımsızdır.
  sessionVersion Int @default(0)

  /// Yetki rolü. Yeni kayıtlar ve mevcut tüm kullanıcılar CUSTOMER'dır;
  /// ADMIN yalnızca kontrollü bir komutla verilir (scripts/rol-ata.mjs).
  role UserRole @default(CUSTOMER)

  records                 ItemRecord[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  tags                    Tag[]

  /// Bu kullanıcının başlattığı ve kendisine gönderilen sahiplik devirleri.
  sentTransfers     OwnershipTransfer[] @relation("TransferFromUser")
  receivedTransfers OwnershipTransfer[] @relation("TransferToUser")

  /// Üye olarak verilen siparişler. Misafir siparişler hiçbir kullanıcıya
  /// bağlı değildir (bkz. Order.userId).
  orders Order[]

  /// Kullanıcının oluşturduğu acil durum profilleri (isteğe bağlı özellik).
  emergencyProfiles EmergencyProfile[]
}

/// Şifre sıfırlama tokenları.
/// Token düz metin saklanmaz; yalnızca SHA-256 özeti tutulur.
/// Veritabanı sızsa bile özetten geçerli token üretilemez.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// E-posta doğrulama tokenları.
/// `email` alanı, ileride e-posta değişikliği doğrulaması için hedef adresi tutar.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ItemRecord {
  id          String   @id
  assetName   String
  ownerName   String
  phone       String
  email       String
  description String
  category    String
  status      String
  createdAt   DateTime

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  finderMessages FinderMessage[]

  /// Bu ürüne bağlı etiket. Eski (legacy) kayıtlarda etiket bulunmaz;
  /// onlar /item/<kayıt-id> adresinden erişilmeye devam eder.
  tag Tag?

  ownershipTransfers OwnershipTransfer[]

  /// Bu kayda bağlı acil durum profili (en fazla bir tane, isteğe bağlı).
  emergencyProfile EmergencyProfile?
}

/// Fiziksel QR/NFC etiketi.
///
/// Eski akıştan farkı: genel erişim adresi veritabanı ID'si yerine
/// kriptografik olarak üretilmiş `publicToken` kullanır (/t/<token>).
/// Etiket, aktivasyon koduna sahip olan kullanıcı tarafından bir kez
/// aktive edilir ve bir ürüne bağlanır.
model Tag {
  id String @id @default(cuid())

  /// Etiketin üzerine basılan, insan tarafından okunabilen kod (ARK-XXXX-XXXX).
  /// Gizli değildir; yalnızca etiketi tanımlar.
  code String @unique

  /// QR/NFC adresinde kullanılan kriptografik token (256 bit).
  /// Tahmin edilemez ve veritabanı ID'si içermez.
  publicToken String @unique

  /// unused | active | inactive | revoked
  status String @default("unused")

  /// Etiketin basıldığı fiziksel ürün türü (src/lib/siparis.ts içindeki
  /// SIPARIS_URUNLERI kodları: sticker-seti, arac-stickeri, ...).
  ///
  /// Neden enum değil: ürün listesi uygulama kodunda tanımlı ve zamanla
  /// değişiyor. Enum olsaydı her yeni ürün için migration gerekirdi.
  /// Geçerlilik denetimi üretim ucunda yapılır.
  ///
  /// Null = tür eklenmeden önce üretilmiş eski stok. Bu etiketler sipariş
  /// karşılamada KULLANILMAZ; önce sınıflandırılmaları gerekir.
  productKod String?

  /// Aktivasyon kodunun SHA-256 özeti. Kod düz metin saklanmaz;
  /// yalnızca fiziksel etiketin üzerinde bulunur.
  activationCodeHash String

  activatedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Etiketi aktive eden (sahibi olan) kullanıcı.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Etiketin bağlı olduğu ürün. Bir ürünün en fazla bir etiketi olur.
  itemRecordId String?     @unique
  itemRecord   ItemRecord? @relation(fields: [itemRecordId], references: [id], onDelete: SetNull)

  events TagEvent[]

  /// Bu etiket bir siparişe ayrıldıysa rezervasyon kaydı. Rezervasyon
  /// SAHİPLİK DEĞİLDİR: status "unused" kalır ve userId yazılmaz.
  orderTag OrderTag?

  @@index([status])
  @@index([userId])
  /// Stok sorguları her zaman "hangi üründen kaç boş etiket var" biçiminde.
  @@index([productKod, status])
}

/// Etiket geçmişi. Aktivasyon, ürün değişimi, devir ve iptal işlemleri
/// geri dönük olarak izlenebilsin diye kaydedilir.
model TagEvent {
  id String @id @default(cuid())

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  /// activated | moved | deactivated | reactivated | revoked | transferred
  /// | classified
  type String

  /// İşlemi yapan kullanıcı. Yönetici işlemlerinde null olabilir.
  actorUserId String?

  fromItemRecordId String?
  toItemRecordId   String?
  fromUserId       String?
  toUserId         String?

  /// Ürün türü sınıflandırmasının denetim izi ("classified" olayı).
  /// Eski (türsüz) etiketlerde `fromProductKod` null olur.
  fromProductKod String?
  toProductKod   String?

  createdAt DateTime @default(now())

  @@index([tagId])
  @@index([createdAt])
}

/// Kullanıcı yetki rolü.
///
/// Yetkilendirme KARARI her zaman bu alanın veritabanındaki güncel
/// değerine göre verilir. Rol oturum tokenına yazılmaz: token imzalı olsa
/// bile üretildiği andaki değeri taşır ve rol geri alındığında token
/// süresi dolana kadar eski yetkiyi taşımaya devam ederdi.
enum UserRole {
  CUSTOMER
  ADMIN
}

enum OwnershipTransferStatus {
  pending
  accepted
  cancelled
  expired
}

/// Ürün sahipliğinin başka bir kullanıcıya devri.
///
/// Akış: mevcut sahip bir davet oluşturur, davet e-posta ile karşı tarafa
/// gider ve yalnızca karşı taraf kabul ederse ürün el değiştirir.
///
/// Token düz metin saklanmaz; PasswordResetToken'da olduğu gibi yalnızca
/// SHA-256 özeti tutulur. Davet tek kullanımlıktır, `expiresAt` ile sürelidir
/// ve kabul edilmeden önce gönderen tarafından iptal edilebilir.
model OwnershipTransfer {
  id String @id @default(cuid())

  itemRecordId String
  itemRecord   ItemRecord @relation(fields: [itemRecordId], references: [id], onDelete: Cascade)

  /// Daveti başlatan mevcut sahip.
  fromUserId String
  fromUser   User   @relation("TransferFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)

  /// Davet edilen kullanıcı. Davet anında hesabı yoksa null kalır ve
  /// kabul sırasında doldurulur.
  toUserId String?
  toUser   User?   @relation("TransferToUser", fields: [toUserId], references: [id], onDelete: SetNull)

  /// Davetin gönderildiği e-posta adresi.
  toEmail String

  tokenHash String @unique

  status OwnershipTransferStatus @default(pending)

  expiresAt   DateTime
  acceptedAt  DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemRecordId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([toEmail])
  @@index([status])
  @@index([expiresAt])
}

model FinderMessage {
  id                  String    @id
  recordId            String
  finderName          String
  finderPhone         String
  finderEmail         String?
  location            String
  message             String
  status              String
  emailDeliveryStatus String?
  emailDeliveredAt    DateTime?
  createdAt           DateTime

  record ItemRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

/// Hız sınırlama sayaçları.
///
/// Vercel birden fazla sunucu örneği çalıştırdığı için bellek içi sayaç
/// güvenilir değildir; sayaçlar tüm örneklerin paylaştığı veritabanında tutulur.
///
/// `key` alanı ham IP veya e-posta İÇERMEZ; kişisel veri saklamamak için
/// değerin HMAC-SHA256 özeti kullanılır.
model RateLimitEntry {
  key          String    @id
  count        Int       @default(0)
  windowEnd    DateTime
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([windowEnd])
}

/// Sipariş durumu.
///
/// `stok_bekliyor` gibi bir ara durum YOKTUR: QR etiketleri ödeme
/// başlatılmadan önce rezerve edildiği için, ödeme alındıktan sonra stok
/// tükenmesi mümkün değildir. Stok yetmiyorsa sipariş hiç oluşmaz.
enum OrderStatus {
  pending
  paid
  preparing
  shipped
  cancelled
  failed
}

/// Tek bir ödeme denemesinin durumu. Sipariş durumundan ayrıdır:
/// bir siparişte başarısız denemelerin ardından başarılı bir deneme olabilir.
enum PaymentStatus {
  pending
  succeeded
  failed
  cancelled
}

/// Müşteri siparişi.
///
/// MİSAFİR SİPARİŞ desteklenir: sipariş bir kullanıcı hesabına bağlı olmak
/// zorunda değildir. QR aktivasyonundaki kayıt/giriş zorunluluğu ayrıdır ve
/// bu modelden etkilenmez.
///
/// Sipariş SİLİNMEZ; iptal `cancelled` durumuyla yapılır. Ödeme ve denetim
/// kayıtları bu yüzden Cascade ile bağlanmaz.
model Order {
  id String @id @default(cuid())

  /// Müşteriye ve yöneticiye gösterilen kısa numara.
  orderNumber String @unique

  /// Sipariş takip adresi için kriptografik token. Tahmin edilemez ve
  /// veritabanı ID'si içermez (Tag.publicToken ile aynı kalıp).
  publicToken String @unique

  /// Üye sipariş verdiyse dolar; misafir siparişte null kalır.
  /// Hesap silinirse sipariş kaydı korunur, yalnızca bağ kopar.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Sipariş anındaki iletişim ve teslimat bilgileri (anlık kopya).
  /// Yalnızca kargo ve sipariş bildirimi için gereken alanlar tutulur;
  /// kimlik numarası, doğum tarihi ve kart verisi SAKLANMAZ.
  fullName    String
  email       String
  phone       String
  addressLine String
  district    String
  city        String
  postalCode  String?

  /// Tutarlar kuruş TAMSAYISIDIR; kayan noktalı para hesabı yapılmaz.
  /// Hepsi sunucuda src/lib/siparis.ts kaynağından hesaplanır; istemciden
  /// gelen hiçbir tutar kabul edilmez.
  ///
  /// Negatif değer ve toplam tutarlılığı veritabanı CHECK kısıtlarıyla
  /// korunur; Prisma şema dili CHECK ifade edemediği için bu kısıtlar
  /// migration SQL'ine elle eklenir.
  subtotalKurus Int
  shippingKurus Int
  totalKurus    Int
  currency      String @default("TRY")

  status OrderStatus @default(pending)

  paidAt      DateTime?
  shippedAt   DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]
  tags     OrderTag[]
  events   OrderEvent[]
  consents OrderConsent[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([email])
}

/// Sipariş kalemi.
///
/// Ürün tablosu yoktur; ad, seçenek, birim fiyat ve QR adedi sipariş anında
/// src/lib/siparis.ts kaynağından kopyalanır. Ürün tanımı sonradan değişse
/// veya listeden kalksa bile geçmiş sipariş bozulmaz.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productKod String
  productAdi String

  /// Ürün seçeneği. Mevcut beş üründe seçenek yoktur, bugün null kalır.
  secenek String?

  quantity Int

  /// Bir adet üründe kaç benzersiz QR etiketi bulunduğu (anlık kopya).
  /// Rezerve edilecek etiket sayısı: quantity * qrAdedi.
  qrAdedi Int

  unitPriceKurus Int
  lineTotalKurus Int

  createdAt DateTime @default(now())

  orderTags OrderTag[]

  @@index([orderId])
}

/// Ödeme denemesi.
///
/// Kart bilgisi ARKVIUM sunucusuna hiç gelmez ve hiçbir alanda tutulmaz.
/// Mali kayıt olduğu için sipariş silinerek yok edilemez (onDelete: Restrict).
model Payment {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  provider String

  /// IDEMPOTENCY (başlatma tarafı): ödeme başlatılırken bizim ürettiğimiz
  /// tekil referans. Sağlayıcıya gönderilir, dönüşte eşleştirme bununla
  /// yapılır. Unique kısıt aynı denemenin iki kez oluşmasını engeller.
  providerConversationId String @unique

  /// Sağlayıcının kendi ödeme kimliği. Başlatma anında bilinmediği için
  /// opsiyoneldir; geldiğinde tekildir (PostgreSQL birden çok NULL'a izin verir).
  providerRef String? @unique

  status PaymentStatus @default(pending)

  amountKurus Int
  currency    String @default("TRY")

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  updatedAt   DateTime  @updatedAt

  events PaymentEvent[]

  @@index([orderId])
  @@index([status])
}

/// Sağlayıcıdan gelen ödeme bildirimi kaydı.
model PaymentEvent {
  id String @id @default(cuid())

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  /// IDEMPOTENCY (webhook tarafı): tekrar gelen aynı bildirimin ikinci kez
  /// işlenmesini ENGELLEYEN tek kısıt. Değer, iyzico entegrasyonunda
  /// DOĞRULANAN webhook alanlarının kararlı birleşiminden türetilir;
  /// sağlayıcının bağımsız bir olay kimliği verdiği VARSAYILMAZ.
  eventKey String @unique

  /// Sağlayıcıdan gelen durum metni. Ham gövde SAKLANMAZ ve LOGLANMAZ.
  eventType String

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([paymentId])
}

/// Bir siparişe ayrılan QR etiketi (rezervasyon).
///
/// REZERVASYON SAHİPLİK DEĞİLDİR: Tag.status "unused" kalır ve Tag.userId
/// yazılmaz. Sahiplik yalnızca aktivasyonda, aktivasyon kodu doğrulandıktan
/// sonra kurulur (src/app/api/tags/activate/route.ts değişmez).
///
/// Etiketler ödeme BAŞLATILMADAN ÖNCE tek transaction içinde rezerve edilir.
/// Rezervasyon serbest bırakılırken bu satır SİLİNİR; iz OrderEvent'te kalır.
/// "releasedAt" gibi bir alan yoktur: işaretli satır, tagId unique kısıtı
/// yüzünden etiketi kalıcı olarak kilitlerdi.
model OrderTag {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Etiketin hangi sipariş kalemine ait olduğu. Hazırlık ve baskı bu bağ
  /// olmadan yapılamaz (bir siparişte birden çok ürün bulunabilir).
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// AYNI QR İKİ SİPARİŞE AYRILAMAZ kuralının tek gerçek garantisi.
  /// Uygulama mantığı değil, veritabanı kısıtı sağlar.
  /// Rezerve bir etiket silinemez.
  tagId String @unique
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  reservedAt DateTime @default(now())

  /// Rezervasyonun son geçerlilik anı (OwnershipTransfer.expiresAt kalıbı).
  /// Süresi geçmiş rezervasyon yok sayılır ve yeni rezervasyon
  /// transaction'ının ilk adımında silinir; ayrı zamanlanmış görev gerekmez.
  ///
  /// Süre değeri koda gömülmez: doğrulanmış iyzico ödeme oturumu süresinden
  /// veya doğrulanmış sunucu ayarından üretilir.
  reservationExpiresAt DateTime

  @@index([orderId])
  @@index([orderItemId])
  @@index([reservationExpiresAt])
}

/// Sipariş denetim izi. TagEvent ile aynı kalıptadır.
/// Denetim kaydı olduğu için sipariş silinerek yok edilemez.
model OrderEvent {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// created | payment_started | paid | payment_failed | tags_reserved |
  /// tags_released | preparing | shipped | cancelled
  type String

  /// Yönetici işlemlerinde dolar; otomatik işlemlerde null.
  actorAdminEmail String?

  /// Kısa açıklama. Kişisel veri, kart bilgisi veya anahtar İÇERMEZ.
  note String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

/// Sipariş sırasında onaylanan hukuki metinlerin kaydı.
///
/// Yalnızca hangi belgenin hangi sürümünün ne zaman onaylandığı tutulur;
/// metinlerin kendisi burada üretilmez. Hukuki kanıt olduğu için sipariş
/// silinerek yok edilemez.
model OrderConsent {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// mesafeli_satis | on_bilgilendirme | kvkk_aydinlatma | iade_kosullari
  belge String

  /// Onaylanan metnin sürümü.
  surum String

  onaylandiAt DateTime @default(now())

  @@unique([orderId, belge])
  @@index([orderId])
}

/// Acil Durum Profili — TAMAMEN İSTEĞE BAĞLI özellik.
///
/// ÖZEL NİTELİKLİ KİŞİSEL VERİ: sağlık bilgileri KVKK m.6 kapsamındadır.
/// Bu yüzden:
/// - Profil varsayılan olarak KAPALIDIR (`enabled` false).
/// - Her alan ayrı ayrı görünür yapılır; varsayılan hepsi KAPALI.
/// - BEYAN EDİLEN TÜM ALANLAR (kan grubu dâhil) uygulama katmanında
///   AES-256-GCM ile şifrelenir (bkz. src/lib/acil-durum-sifreleme.ts).
///   Veritabanında düz metin sağlık verisi durmaz.
/// - Açık rıza zamanı ve metin SÜRÜMÜ kaydedilir. Public sorgu
///   (`acilDurumGorunumu`) kayıtlı sürümü yürürlükteki `ONAY_METNI_SURUMU`
///   ile TAM EŞİTLİK karşılaştırır; eski sürümlü profil gösterilmez.
/// - İçerik güncellenince profil otomatik olarak yayından kalkar; yeniden
///   yayına almak için YENİ açık rıza gerekir.
///
/// Kayıt silinirse profil de silinir (Cascade): sağlık verisi öksüz kalmamalı.
model EmergencyProfile {
  id String @id @default(cuid())

  /// Profili oluşturan sahip. Sahiplik kontrolü sunucuda bu alanla yapılır.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Bağlı olduğu ürün kaydı. Bir kayıtta en fazla bir profil olur.
  itemRecordId String     @unique
  itemRecord   ItemRecord @relation(fields: [itemRecordId], references: [id], onDelete: Cascade)

  /// Profil yayında mı. Varsayılan KAPALI.
  enabled Boolean @default(false)

  /// --- Beyan edilen bilgiler ---
  /// TÜM alanlar ŞİFRELİ saklanır; ham hâlleriyle sorgulanamaz.
  ///
  /// `bloodType` de sağlık verisidir ve düz metin tutulmaz: uygulama
  /// katmanında geçerli bir kan grubu koduna (bkz. KAN_GRUPLARI) doğrulanıp
  /// şifrelenmiş biçimde yazılır.
  displayName       String?
  bloodType         String?
  allergies         String?
  medications       String?
  medicalConditions String?
  emergencyNote     String?

  /// --- Alan bazlı görünürlük ---
  /// JSON kullanılmaz: her alan ayrı sütun, tip güvenli ve sorgulanabilir.
  displayNameGorunur       Boolean @default(false)
  bloodTypeGorunur         Boolean @default(false)
  allergiesGorunur         Boolean @default(false)
  medicationsGorunur       Boolean @default(false)
  medicalConditionsGorunur Boolean @default(false)
  emergencyNoteGorunur     Boolean @default(false)
  contactsGorunur          Boolean @default(false)

  /// --- Onay kayıtları (denetim izi) ---
  disclaimerAcceptedAt                  DateTime?
  explicitConsentAt                     DateTime?
  /// Onaylanan metnin sürümü. Public sorgu bu değeri yürürlükteki
  /// `ONAY_METNI_SURUMU` ile karşılaştırır; farklı veya boşsa profil public
  /// alanda GÖSTERİLMEZ. Metin değişince eski onaylar böylece geçersiz olur.
  explicitConsentVersion                String?
  emergencyContactDeclarationAcceptedAt DateTime?

  /// Rıza geri çekildiğinde veya profil kapatıldığında yazılır.
  consentWithdrawnAt DateTime?
  disabledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts EmergencyContact[]

  @@index([userId])
}

/// Acil durum yakını. Uygulama katmanında profil başına EN FAZLA 2 kayıt.
///
/// `name` ve `phone` ŞİFRELİ saklanır. Telefon numarası public sayfada metin
/// olarak yazılmaz; arama yapılabilmesi için `tel:` bağlantısının içinde yer
/// alır (yalnızca profil yayındayken ve kişiler görünür işaretliyken).
model EmergencyContact {
  id String @id @default(cuid())

  emergencyProfileId String
  emergencyProfile   EmergencyProfile @relation(fields: [emergencyProfileId], references: [id], onDelete: Cascade)

  name         String
  relationship String?
  phone        String

  /// Gösterim sırası: 1 birinci yakın, 2 ikinci yakın.
  priority Int
  enabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([emergencyProfileId, priority])
  @@index([emergencyProfileId])
}
