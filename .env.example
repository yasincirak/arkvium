# ARKVIUM — ortam değişkenleri örneği
#
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env ve .env.local dosyaları .gitignore içindedir, asla commit edilmez.
#
#   cp .env.example .env
#
# Aşağıda yalnızca değişken adları ve açıklamaları vardır; gerçek değer yoktur.


# ---------------------------------------------------------------------------
# Veritabanı (Supabase / PostgreSQL)
# ---------------------------------------------------------------------------

# Uygulamanın çalışma anında kullandığı bağlantı.
# Supabase > Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL=

# Prisma migration'larının kullandığı doğrudan bağlantı (pooler değil).
# Supabase > Project Settings > Database > Connection string > Direct connection
DIRECT_URL=


# ---------------------------------------------------------------------------
# Oturum güvenliği (zorunlu)
# ---------------------------------------------------------------------------
# Her iki anahtar da en az 32 karakter olmalıdır ve birbirinden FARKLI olmalıdır.
# Eksik veya kısa olursa uygulama bilerek hata verir; sabit yedek değer yoktur.
#
# Güvenli değer üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

USER_SESSION_SECRET=
ADMIN_SESSION_SECRET=


# ---------------------------------------------------------------------------
# Yönetici girişi
# ---------------------------------------------------------------------------

# Yönetim paneline giriş yapacak e-posta adresi.
ADMIN_EMAIL=

# Yönetici şifresinin bcrypt hash'i, BASE64 kodlu. Düz şifre YAZILMAZ.
# Değeri üretmek ve .env'e yazmak için:
#   npm run hash-password
#
# NEDEN BASE64? bcrypt hash'leri "$2b$12$..." biçimindedir. Next.js env
# yükleyicisi .env içindeki "$isim" kalıplarını değişken referansı sayıp
# genişletir ve hash bozulur; sonuç, doğru şifreyle bile giriş yapılamamasıdır.
# base64 alfabesinde "$" bulunmadığı için bu sorun ortadan kalkar.
ADMIN_PASSWORD_HASH_B64=


# ---------------------------------------------------------------------------
# E-posta bildirimi (Gmail SMTP)
# ---------------------------------------------------------------------------
# Bulan kişi bildirimi eşya sahibine bu hesaptan gönderilir.
# Normal Gmail şifresi değil, "uygulama şifresi" kullanılır:
# Google Hesabı > Güvenlik > 2 Adımlı Doğrulama > Uygulama şifreleri

GMAIL_USER=
GMAIL_APP_PASSWORD=


# ---------------------------------------------------------------------------
# Uygulama adresi
# ---------------------------------------------------------------------------
# QR kodlarının işaret ettiği genel adres. Sonunda "/" olmamalıdır.
# Yerel geliştirme:  http://localhost:3000
# Canlı:             https://alanadiniz.com

NEXT_PUBLIC_APP_URL=


# ---------------------------------------------------------------------------
# Destek WhatsApp numarası (isteğe bağlı)
# ---------------------------------------------------------------------------
# Eşya bulan kişinin ARKVIUM destek hattına yazabilmesi için kullanılır.
# Ülke kodu ile, boşluksuz ve "+" olmadan yazılır. Örnek biçim: 905XXXXXXXXX
# Tanımlı değilse WhatsApp butonu gösterilmez.

NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Acil Durum Profili sağlık/iletişim alanlarının şifrelenmesi için 32 baytlık
# anahtar. Üretmek için: openssl rand -base64 32
# Tanımlı değilse acil durum profili yazma işlemleri 503 ile reddedilir;
# uygulama ASLA şifresiz veri yazmaz.
EMERGENCY_DATA_ENCRYPTION_KEY=

# WhatsApp destek hattı — ülke kodu dâhil YALNIZCA rakam (örn. 905XXXXXXXXX).
# +, boşluk, parantez veya tire kullanılmaz.
# Tanımlı değilse veya biçimi bozuksa WhatsApp destek butonu HİÇ gösterilmez.
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=
